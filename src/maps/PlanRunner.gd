class_name PlanRunner
extends RefCounted
## Executes a street-plan op list (generated by tools/mapproto) into a MapDef: floor with sunken holes,
## building masses, enterable rooms with doorways and roofs, walls, cover, columns, raised platforms,
## stairs, ladders, ziplines, launch pads, phase gates, temporal barricades, lights, spawns and the Hot Return
## layout. All collision goes through MapDef/MapKit so navigation baking and the minimap see it.
##
## Op fields are documented in tools/mapproto/proto.py. Material names are looked up in `mats`.

const DOOR_H := 3.4


static func _v2(a: Array) -> Vector2:
	return Vector2(float(a[0]), float(a[1]))


static func _v3(a: Array) -> Vector3:
	return Vector3(float(a[0]), float(a[1]), float(a[2]))


static func _poly(a: Array) -> PackedVector2Array:
	var out := PackedVector2Array()
	for p in a:
		out.append(Vector2(float(p[0]), float(p[1])))
	return out


static func _m(mats: Dictionary, name: String) -> Material:
	if mats.has(name):
		return mats[name]
	return mats.get("wall_a")


static func run(def: MapDef, ops: Array, layout: Dictionary, extent: Vector2, mats: Dictionary) -> Dictionary:
	def.extent = extent
	var stats := {"blocks": 0, "rooms": 0, "covers": 0, "columns": 0, "platforms": 0, "walls": 0}
	# ---- floor: outline minus sunken holes
	var outline := PackedVector2Array()
	var holes: Array = []
	for op in ops:
		match str(op["op"]):
			"outline":
				outline = _poly(op["poly"])
			"sunken":
				var r: Array = op["r"]
				holes.append(PackedVector2Array([Vector2(r[0], r[1]), Vector2(r[2], r[1]), Vector2(r[2], r[3]), Vector2(r[0], r[3])]))
	MapKit.floor_with_holes(def, outline, holes, 0.0, 3.5, _m(mats, "floor"))
	def.outline = outline
	_perimeter(def, ops, outline, mats)
	# ---- everything else in authored order
	for op in ops:
		var kind := str(op["op"])
		match kind:
			"sunken":
				var r: Array = op["r"]
				var pts := PackedVector2Array([Vector2(float(r[0]) - 0.6, float(r[1]) - 0.6), Vector2(float(r[2]) + 0.6, float(r[1]) - 0.6), Vector2(float(r[2]) + 0.6, float(r[3]) + 0.6), Vector2(float(r[0]) - 0.6, float(r[3]) + 0.6)])
				MapKit.slab(def, pts, float(op["y"]), 0.8, _m(mats, str(op.get("mat", "floor_lo"))), true, false)
				def.floor_polys.append({"pts": PackedVector2Array([Vector2(r[0], r[1]), Vector2(r[2], r[1]), Vector2(r[2], r[3]), Vector2(r[0], r[3])]), "y": float(op["y"])})
			"block":
				_block(def, op, mats)
				stats["blocks"] += 1
			"poly_block":
				var h := float(op["h"])
				var y0 := float(op.get("y0", 0.0))
				MapKit.slab(def, _poly(op["poly"]), y0 + h, h, _m(mats, str(op["mat"])), true, false)
				stats["blocks"] += 1
			"room":
				_room(def, op, mats)
				stats["rooms"] += 1
			"wall":
				MapKit.wall(def, _v2(op["a"]), _v2(op["b"]), float(op["h"]), float(op["t"]), _m(mats, str(op["mat"])), float(op.get("y0", 0.0)))
				stats["walls"] += 1
			"cover":
				_cover(def, op, mats)
				stats["covers"] += 1
			"column":
				var p: Array = op["p"]
				MapDecor.solid_column(def, Vector3(p[0], float(op.get("y0", 0.0)), p[1]), float(op["h"]), float(op["r"]), _m(mats, str(op.get("mat", "column"))), float(op.get("broken", 0.0)))
				stats["columns"] += 1
			"slab":
				var top := float(op["top"])
				var thick := top + 0.6 if bool(op.get("solid", true)) else float(op.get("thick", 0.4))
				var body := MapKit.slab(def, _poly(op["poly"]), top, thick, _m(mats, str(op.get("mat", "floor_hi"))), bool(op.get("walk", true)), bool(op.get("walk", true)))
				if body != null and bool(op.get("roof", false)):
					body.add_to_group("roof")
				stats["platforms"] += 1
			"stairs":
				MapKit.stairs(def, _v3(op["low"]), _v3(op["high"]), float(op["w"]), _m(mats, "stairs"), _m(mats, "stairs_step"))
			"ladder":
				var o: Array = op["out"]
				MapKit.ladder(def, _v3(op["base"]), float(op["top"]), Vector3(o[0], 0, o[1]), str(op["name"]))
			"zip":
				def.add_zipline(_v3(op["a"]), _v3(op["b"]), str(op["name"]))
			"sling":
				def.add_sling(_v3(op["pad"]), _v3(op["land"]), float(op["flight"]), str(op["name"]))
			"gate":
				def.add_gate_pair(_v3(op["a"]), float(op["a_yaw"]), _v3(op["b"]), float(op["b_yaw"]), str(op["name"]))
			"prop":
				var pp: Array = op["p"]
				var sz: Array = op["size"]
				def.add_temporal_prop(Vector3(pp[0], float(op.get("y", 0.0)), pp[1]), Vector3(sz[0], sz[1], sz[2]), float(op["yaw"]), Color(str(op["color"])))
			"light":
				_light(def, op)
			"spawn":
				var sp: Array = op["p"]
				def.spawn_point("attack" if int(op["team"]) == 1 else "defend", Vector3(sp[0], 0.5, sp[1]), float(op["yaw"]))
			"decor":
				_decor(def, op, mats)
	# ---- Hot Return layout, spawns for Relic Rush, shards, beacons
	if not layout.is_empty():
		var fields: Array = layout["fields"]
		def.hot_return_layout(_v3(layout["vault1"]), _v3(layout["vault2"]), _v3(layout["stab1"]), _v3(layout["stab2"]), _v3(fields[0]), _v3(fields[1]), float(layout["radius"]), float(layout["height"]))
		def.core_spawn = _v3(layout["vault1"]) + Vector3(0, 0.6, 0)
		for f in layout.get("ffa", []):
			def.ffa_spawn(Vector3(f[0], ground_y(ops, float(f[0]), float(f[1])) + 0.5, f[1]), float(f[2]))
		for s in layout.get("shards", []):
			def.shard_points.append(_v3(s))
		for b in layout.get("beacons", []):
			def.beacon_points.append(_v3(b))
	return stats


## Perimeter: tall walls everywhere except the open rails (sea / drop beyond): a low visible rail with an
## invisible barrier above it, so nothing leaves the playable outline and nothing is shot out of it.
static func _perimeter(def: MapDef, ops: Array, outline: PackedVector2Array, mats: Dictionary) -> void:
	var rails: Array = []
	for op in ops:
		if str(op["op"]) == "outline":
			for r in op.get("rails", []):
				rails.append(Rect2(Vector2(float(r[0]), float(r[1])), Vector2(float(r[2]) - float(r[0]), float(r[3]) - float(r[1]))))
	var n := outline.size()
	for i in n:
		var a := outline[i]
		var b := outline[(i + 1) % n]
		var mid := (a + b) * 0.5
		var is_rail := false
		for r in rails:
			if (r as Rect2).grow(0.6).has_point(mid):
				is_rail = true
		if is_rail:
			var rail := MapKit.wall(def, a, b, 1.2, 0.5, _m(mats, "rail"))
			var barrier := MapKit.wall(def, a, b, 3.2, 0.5, _m(mats, "rail"), 1.2, false)
			for c in barrier.get_children():
				if c is MeshInstance3D:
					(c as MeshInstance3D).visible = false
			rail.add_to_group("rail")
		else:
			MapKit.wall(def, a, b, 9.0, 1.2, _m(mats, "wall_a"))


## Floor height at (x, z) from the plan: raised platforms and sunken basins override the ground at 0.
static func ground_y(ops: Array, x: float, z: float) -> float:
	var best := 0.0
	var p := Vector2(x, z)
	for op in ops:
		match str(op["op"]):
			"slab":
				if bool(op.get("walk", true)) and Geometry2D.is_point_in_polygon(p, _poly(op["poly"])):
					best = maxf(best, float(op["top"]))
			"sunken":
				var r: Array = op["r"]
				if x >= float(r[0]) and x <= float(r[2]) and z >= float(r[1]) and z <= float(r[3]):
					best = minf(best, float(op["y"]))
	return best


static func _block(def: MapDef, op: Dictionary, mats: Dictionary) -> StaticBody3D:
	var r: Array = op["r"]
	var h := float(op["h"])
	var y0 := float(op.get("y0", 0.0))
	var size := Vector3(float(r[2]) - float(r[0]), h, float(r[3]) - float(r[1]))
	var pos := Vector3((float(r[0]) + float(r[2])) * 0.5, y0 + h * 0.5, (float(r[1]) + float(r[3])) * 0.5)
	return def.box(pos, size, _m(mats, str(op["mat"])), "", true)


static func _cover(def: MapDef, op: Dictionary, mats: Dictionary) -> void:
	var p: Array = op["p"]
	var sz: Array = op["size"]
	var y0 := float(op.get("y0", 0.0))
	var mat := _m(mats, str(op.get("mat", "cover_stone")))
	if str(op["kind"]) == "cyl":
		def.cylinder(Vector3(p[0], y0 + float(sz[1]) * 0.5, p[1]), float(sz[0]), float(sz[1]), mat, true)
	else:
		var b := def.box(Vector3(p[0], y0 + float(sz[1]) * 0.5, p[1]), Vector3(sz[0], sz[1], sz[2]), mat, "", true)
		b.rotation.y = deg_to_rad(float(op.get("yaw", 0.0)))


## Walls with doorways (lintels above), optional roof slab, optional interior lights.
static func _room(def: MapDef, op: Dictionary, mats: Dictionary) -> void:
	var r: Array = op["r"]
	var x0 := float(r[0])
	var z0 := float(r[1])
	var x1 := float(r[2])
	var z1 := float(r[3])
	var h := float(op["h"])
	var t := float(op.get("t", 0.8))
	var fl := float(op.get("floor", 0.0))
	var mat := _m(mats, str(op["mat"]))
	var sides := {
		"n": [Vector2(x0, z0 + t * 0.5), Vector2(x1, z0 + t * 0.5)],
		"s": [Vector2(x0, z1 - t * 0.5), Vector2(x1, z1 - t * 0.5)],
		"w": [Vector2(x0 + t * 0.5, z0), Vector2(x0 + t * 0.5, z1)],
		"e": [Vector2(x1 - t * 0.5, z0), Vector2(x1 - t * 0.5, z1)],
	}
	var doors: Dictionary = op.get("doors", {})
	for k in sides:
		var a: Vector2 = sides[k][0]
		var b: Vector2 = sides[k][1]
		var length := a.distance_to(b)
		var dir := (b - a) / length
		var cuts: Array = []
		for d in doors.get(k, []):
			var c := length * 0.5 + float(d[0])
			cuts.append([c - float(d[1]) * 0.5, c + float(d[1]) * 0.5])
		cuts.sort_custom(func(m, n) -> bool: return m[0] < n[0])
		var tcur := 0.0
		for c in cuts + [[length, length]]:
			if float(c[0]) - tcur > 0.25:
				MapKit.wall(def, a + dir * tcur, a + dir * float(c[0]), h, t, mat, fl)
			if float(c[0]) < length and h - DOOR_H > 0.3:
				MapKit.wall(def, a + dir * float(c[0]), a + dir * float(c[1]), h - DOOR_H, t, mat, fl + DOOR_H, false)
			tcur = float(c[1])
	var roof_name := str(op.get("roof", ""))
	if roof_name != "":
		var pts := PackedVector2Array([Vector2(x0 - 0.1, z0 - 0.1), Vector2(x1 + 0.1, z0 - 0.1), Vector2(x1 + 0.1, z1 + 0.1), Vector2(x0 - 0.1, z1 + 0.1)])
		var body := MapKit.slab(def, pts, fl + h + 0.5, 0.5, _m(mats, roof_name), false, false)
		if body != null:
			body.add_to_group("roof")
	for l in op.get("lights", []):
		_light(def, {"p": l, "color": "FFD9A0", "energy": 1.4, "range": maxf(x1 - x0, z1 - z0) * 0.8, "hang": fl + h - float(l[1])})


static func _light(def: MapDef, op: Dictionary) -> void:
	var p: Array = op["p"]
	var l := OmniLight3D.new()
	l.position = Vector3(p[0], p[1], p[2])
	l.light_color = Color(str(op.get("color", "FFD9A0")))
	l.light_energy = float(op.get("energy", 1.2))
	l.omni_range = float(op.get("range", 9.0))
	l.shadow_enabled = false
	l.omni_attenuation = 1.2
	def.features.add_child(l)
	var lamp := MeshInstance3D.new()
	var bm := BoxMesh.new()
	bm.size = Vector3(1.4, 0.12, 0.45)
	lamp.mesh = bm
	lamp.position = Vector3(p[0], float(p[1]) + 0.35, p[2])
	var lm := StandardMaterial3D.new()
	lm.albedo_color = l.light_color
	lm.emission_enabled = true
	lm.emission = l.light_color
	lm.emission_energy_multiplier = 1.8
	lm.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	lamp.material_override = lm
	lamp.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	def.features.add_child(lamp)
	var hang := float(op.get("hang", 0.0))
	if hang > 0.4:
		var rod := MeshInstance3D.new()
		var cm := CylinderMesh.new()
		cm.top_radius = 0.03
		cm.bottom_radius = 0.03
		cm.height = hang
		cm.radial_segments = 4
		rod.mesh = cm
		rod.position = Vector3(p[0], float(p[1]) + hang * 0.5 + 0.35, p[2])
		rod.material_override = Style.surface("metal", Color("30343A"))
		rod.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		def.features.add_child(rod)


static func _decor(def: MapDef, op: Dictionary, mats: Dictionary) -> void:
	var p: Array = op["p"]
	var pos := Vector3(p[0], p[1], p[2])
	var h := float(op["h"])
	var yaw := float(op.get("yaw", 0.0))
	var tint := Color(str(op.get("tint", "FFFFFF")))
	var path := ""
	var kind_mat := "foliage"
	match str(op["kind"]):
		"tree":
			path = MapDecor.NATURE + str(op.get("model", "tree_oak.glb"))
		"bush":
			path = MapDecor.NATURE + "plant_bush.glb"
		"statue":
			path = MapDecor.NATURE + str(op.get("model", "statue_obelisk.glb"))
			kind_mat = "stone"
		"rock":
			path = MapDecor.NATURE + str(op.get("model", "rock_largeA.glb"))
			kind_mat = "cliff"
		"model":
			path = str(op["path"])
			kind_mat = str(op.get("style", "metal"))
	if path != "":
		MapDecor.place(def.features, path, pos, h, yaw, kind_mat, tint)
