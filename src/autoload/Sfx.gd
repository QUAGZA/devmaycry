extends Node
## Minimal sound playback. Sounds are generated by tools/gen_sfx.py into res://assets/sfx.

var _streams: Dictionary = {}
var _players: Array[AudioStreamPlayer] = []
const POOL := 8


func _ready() -> void:
	for i in POOL:
		var p := AudioStreamPlayer.new()
		p.bus = "Master"
		add_child(p)
		_players.append(p)


func bus_for(name: String) -> String:
	if name.begins_with("shot") or name == "reload":
		return "Weapons"
	if name == "ui":
		return "UI"
	return "Effects"


func play(name: String, volume_db: float = 0.0, pitch: float = 1.0) -> void:
	if DisplayServer.get_name() == "headless":
		return
	var stream := _get_stream(name)
	if stream == null:
		return
	for p in _players:
		if not p.playing:
			p.stream = stream
			p.bus = bus_for(name) if AudioServer.get_bus_index(bus_for(name)) >= 0 else "Master"
			p.volume_db = volume_db + linear_to_db(clampf(Settings.sfx_volume, 0.0001, 1.0))
			p.pitch_scale = pitch
			p.play()
			return


func _get_stream(name: String) -> AudioStream:
	if _streams.has(name):
		return _streams[name]
	var path := "res://assets/sfx/%s.wav" % name
	if ResourceLoader.exists(path):
		_streams[name] = load(path)
		return _streams[name]
	_streams[name] = null
	return null
